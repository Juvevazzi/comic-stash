<%# Profile form: name, email and an optional new password. The field
    names match what the Rails 8 authentication generator's User model
    expects (email_address, password_challenge), so the back end can save
    them as they are. %>
<section id="profile" class="cs-profile-section" aria-labelledby="profile-title">
  <h2 id="profile-title" class="h4 mb-1">Profile</h2>
  <p class="text-body-secondary">How you appear in Comic Stash and where we reach you.</p>

  <% if @errors.any? %>
    <div class="alert alert-danger" role="alert">
      <%= icon("exclamation-octagon") %>
      <div><strong>Nothing was saved.</strong> Check the <%= pluralize(@errors.size, "field") %> marked below.</div>
    </div>
  <% end %>

  <%= form_with scope: :user, url: profile_path, method: :patch, class: "cs-profile-form" do |f| %>
    <div class="row g-3">
      <div class="col-md-6">
        <%= f.label :name, "Display name", class: "form-label fw-bold" %>
        <%= f.text_field :name, value: @account.name, required: true, autocomplete: "name",
                         class: field_class(:name), aria: field_aria(:name) %>
        <%= field_error(:name) %>
      </div>
      <div class="col-md-6">
        <%= f.label :email_address, "Email", class: "form-label fw-bold" %>
        <%= f.email_field :email_address, value: @account.email_address, required: true, autocomplete: "email",
                          class: field_class(:email_address), aria: field_aria(:email_address, "email-hint") %>
        <div id="email-hint" class="form-text">We send new-issue alerts here.</div>
        <%= field_error(:email_address) %>
      </div>
    </div>

    <details class="cs-disclosure mt-3" <%= "open" if @errors.key?(:password) || @errors.key?(:password_challenge) %>>
      <summary>
        <span>Change password <span class="fw-normal text-body-secondary">· last changed <%= time_ago_in_words(@account.password_changed_at || @account.created_at) %> ago</span></span>
      </summary>
      <div class="row g-3 p-3">
        <div class="col-md-6">
          <%= f.label :password_challenge, "Current password", class: "form-label fw-bold" %>
          <%= f.password_field :password_challenge, autocomplete: "current-password",
                               class: field_class(:password_challenge), aria: field_aria(:password_challenge) %>
          <%= field_error(:password_challenge) %>
        </div>
        <div class="col-md-6">
          <%= f.label :password, "New password", class: "form-label fw-bold" %>
          <%= f.password_field :password, autocomplete: "new-password",
                               class: field_class(:password), aria: field_aria(:password, "password-hint") %>
          <div id="password-hint" class="form-text">At least 8 characters, including a number.</div>
          <%= field_error(:password) %>
        </div>
      </div>
    </details>

    <div class="mt-3">
      <%= f.submit "Save changes", class: "btn btn-primary" %>
    </div>
  <% end %>
</section>