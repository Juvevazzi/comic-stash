<%# Example run on the log-in panel, built from the same .cs-issue tiles the
    series pages will use. Sample data, so the tiles are hidden from screen
    readers and the progress bar carries the summary. %>
<% statuses = %i[owned owned owned owned owned missing owned hunting owned owned missing owned] %>
<div class="cs-auth-card cs-auth-extra cs-run-preview">
  <div class="d-flex justify-content-between align-items-baseline mb-3">
    <span class="fw-bold">Your run, at a glance</span>
    <span class="cs-issue-no text-body-secondary">9 of 12</span>
  </div>
  <div class="progress mb-3" role="progressbar" aria-label="9 of 12 issues owned"
       aria-valuenow="75" aria-valuemin="0" aria-valuemax="100">
    <div class="progress-bar" style="width: 75%"></div>
  </div>
  <ol class="cs-issue-grid mb-3" aria-hidden="true">
    <% statuses.each.with_index(1) do |status, number| %>
      <li><span class="cs-issue is-<%= status %>"><%= number %></span></li>
    <% end %>
  </ol>
  <ul class="cs-legend">
    <li><span class="cs-swatch is-owned"></span>Owned</li>
    <li><span class="cs-swatch is-missing"></span>Missing</li>
    <li><span class="cs-swatch is-hunting"></span>Hunting</li>
  </ul>
</div>