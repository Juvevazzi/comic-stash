<%# What you can do with an issue in the results: open it if you own it,
    otherwise Hunt it / Got it. Locals: comic, status. %>
<% if status == "owned" %>
  <div class="d-flex justify-content-md-end">
    <%= link_to comic_path(comic), class: "btn btn-link btn-sm px-md-2 px-0", "aria-label": "View issue #{comic}" do %>
      View issue <%= icon("arrow-right") %>
    <% end %>
  </div>
<% else %>
  <%= render "shared/issue_actions", comic_id: comic.id, label: comic.to_s, hunting: status == "hunting" %>
<% end %>