<%# Add to / remove from the hunt list.
    Locals: on (true if already hunting), item (optional, e.g. "Night Signal #49",
    read out by screen readers after the label when there are many buttons). %>
<button type="button" class="btn btn-hunt btn-sm" aria-pressed="<%= on %>"
        data-controller="hunt-button" data-hunt-button-on-value="<%= on %>"
        data-action="hunt-button#toggle">
  <%= icon("bookmark") %>
  <span data-hunt-button-target="label"><%= on ? "On your hunt list" : "Add to hunt list" %></span>
  <% if local_assigns[:item] %><span class="visually-hidden"><%= item %></span><% end %>
</button>