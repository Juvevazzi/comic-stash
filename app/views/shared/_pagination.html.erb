<%# Page summary and Previous / page numbers / Next. Every link keeps the
    current filters and sort.
    Locals: page (a SamplePage), link_params (filters plus sort and direction). %>
<div class="cs-table-footer">
  <span class="small text-body-secondary">Page <%= page.page %> of <%= page.pages %> · <%= page.per %> per page</span>
  <% if page.pages > 1 %>
    <nav aria-label="Pages">
      <ul class="pagination pagination-sm mb-0">
        <li class="page-item <%= "disabled" if page.first? %>">
          <% if page.first? %>
            <span class="page-link">Previous</span>
          <% else %>
            <%= link_to "Previous", url_for(link_params.merge(page: page.page - 1)), class: "page-link", rel: "prev" %>
          <% end %>
        </li>
        <% page.window.each do |number| %>
          <% if number.nil? %>
            <li class="page-item disabled"><span class="page-link">…</span></li>
          <% elsif number == page.page %>
            <li class="page-item active"><span class="page-link" aria-current="page"><%= number %></span></li>
          <% else %>
            <li class="page-item">
              <%= link_to number, url_for(link_params.merge(page: number)), class: "page-link",
                          "aria-label": "Page #{number}" %>
            </li>
          <% end %>
        <% end %>
        <li class="page-item <%= "disabled" if page.last? %>">
          <% if page.last? %>
            <span class="page-link">Next</span>
          <% else %>
            <%= link_to "Next", url_for(link_params.merge(page: page.page + 1)), class: "page-link", rel: "next" %>
          <% end %>
        </li>
      </ul>
    </nav>
  <% end %>
</div>