<%# Password input with show/hide button %>

<div class="cs-password-field" data-controller="password-visibility">
  <%= form.password_field field,
        class: "form-control",
        autocomplete: autocomplete,
        required: true,
        "aria-describedby": local_assigns[:describedby],
        data: { password_visibility_target: "input",
                password_rules_target: local_assigns[:describedby] ? "input" : nil,
                action: local_assigns[:describedby] ? "input->password-rules#check" : nil } %>
  <button type="button" class="btn btn-link cs-icon-btn" aria-label="Show password" aria-pressed="false"
          data-password-visibility-target="button" data-action="password-visibility#toggle">
    <%= icon("eye") %>
  </button>
</div>