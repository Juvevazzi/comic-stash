<%# One row of the series table (desktop). Local: series (from Stash#series,
    so it carries publisher_name, released_count and missing_count). %>
<tr>
  <td><%= render "series/cover", series: series %></td>
  <th scope="row"><%= series.display_name %></th>
  <td class="cs-issue-no"><%= series.year_began %></td>
  <td class="<%= series.year_end ? "cs-issue-no" : "text-body-secondary" %>"><%= series.year_end || "Present" %></td>
  <td><%= series.publisher_name %></td>
  <td><%= series.series_type %></td>
  <td>
    <% if series.status %>
      <span class="cs-status <%= series_status_class(series.status) %>"><%= series.status %></span>
    <% end %>
  </td>
  <td class="text-end cs-issue-no"><%= series.released_count %></td>
  <td class="text-end"><%= render "series/missing", series: series %></td>
  <td class="text-end">
    <%= link_to comics_path(series: series.id), class: "btn btn-link btn-sm text-nowrap",
                "aria-label": "View comics in #{series.display_name}" do %>
      View comics <%= icon("arrow-right") %>
    <% end %>
  </td>
</tr>