<%# How many issues are missing from a series, or "Complete". Local: series. %>
<% if series.missing.positive? %>
  <span class="cs-status cs-status-missing"><%= icon("dash-circle-dotted") %><%= series.missing %> missing</span>
<% else %>
  <span class="cs-status cs-status-owned"><%= icon("check2") %>Complete</span>
<% end %>