<%# Whether you're missing this issue: icon and word, never colour alone.
    Local: comic (an Issue from Stash#issues). %>
<% if comic.missing? %>
  <span class="cs-status cs-status-missing"><%= icon("dash-circle-dotted") %>Missing</span>
<% else %>
  <span class="cs-status cs-status-owned"><%= icon("check2") %>Owned</span>
<% end %>