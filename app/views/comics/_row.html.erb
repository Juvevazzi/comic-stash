<%# One row of the comics table (desktop). Local: comic (an Issue from
    Stash#issues, with your stash_status and its publisher_name). %>
<tr class="<%= "is-missing" if comic.missing? %>">
  <td><%= render "shared/cover", tone: comic.tone, image: comic.image_url, css: "cs-thumb-xs" %></td>
  <td><%= comic.series.display_name %></td>
  <td class="cs-issue-no"><%= comic.label %></td>
  <th scope="row"><%= comic.display_title %></th>
  <td><%= comic.publisher_name %></td>
  <td class="text-nowrap"><%= month_year(comic.cover_date) %></td>
  <td><span class="cs-truncate" title="<%= comic.description %>"><%= comic.description %></span></td>
  <td><%= comic.cover_artists.join(", ") %></td>
  <td><%= render "comics/missing", comic: comic %></td>
  <td class="text-end">
    <%= link_to comic_path(comic), class: "btn btn-link btn-sm text-nowrap",
                "aria-label": "View issue #{comic}" do %>
      View issue <%= icon("arrow-right") %>
    <% end %>
  </td>
</tr>