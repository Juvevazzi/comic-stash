<%# "Added just now": what you added in the last hour, each with Undo.
    Local: items (your newest CollectionItems). %>
<section class="card h-100" aria-labelledby="added-h">
  <div class="card-body d-flex flex-column">
    <div class="cs-section-head">
      <h2 id="added-h" class="h4">Added just now</h2>
      <span class="cs-status cs-status-owned"><%= items.size %></span>
    </div>

    <% if items.empty? %>
      <p class="text-body-secondary">Nothing yet. Each comic you add lands here so you can check it.</p>
    <% else %>
      <ul class="cs-row-list mb-3">
        <% items.each do |item| %>
          <li class="align-items-center">
            <%= render "shared/cover", tone: item.issue.tone, css: "cs-thumb-sm" %>
            <div class="cs-grow">
              <span class="d-block fw-bold"><%= item.issue.series.display_name %> <span class="cs-issue-no"><%= item.issue.label %></span></span>
              <span class="small text-body-secondary">
                <span class="font-monospace"><%= item.issue.upc || "No barcode" %></span> · <%= time_ago_in_words(item.created_at) %> ago
              </span>
            </div>
            <%= button_to "Undo", comic_path(item.issue), method: :delete, class: "btn btn-link btn-sm",
                          "aria-label": "Undo adding #{item.issue}" %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <%= link_to "See your whole collection", comics_path, class: "fw-bold mt-auto" %>
  </div>
</section>