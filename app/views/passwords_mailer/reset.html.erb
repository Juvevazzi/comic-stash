<%# The password reset email. The link's token expires, and stops working
    once the password has been changed. %>
<h1>Reset your Comic Stash password</h1>

<p>Hi <%= @user.first_name %>,</p>

<p>Someone (hopefully you) asked to reset the password for <%= @user.email_address %>.</p>

<p><%= link_to "Choose a new password", edit_password_url(@user.password_reset_token) %></p>

<p>
  The link works for <%= distance_of_time_in_words(0, @user.password_reset_token_expires_in) %>.
  If you didn't ask for this, you can ignore this email: your password stays the same.
</p>